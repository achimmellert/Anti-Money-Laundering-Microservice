# ==============================================================================
# Enterprise Anti-Money Laundering (AML) Microservice - Environment Configuration
# Copy this file to '.env' and customize for your environment.
# ==============================================================================

# --- Database & Storage Credentials ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=aml_db
MYSQL_USER=aml_user
MYSQL_PASSWORD=aml_secure_password

# --- Port Bindings (Host Ingress & Inspection) ---
API_PORT=8000
MLFLOW_PORT=5000
MYSQL_PORT=3307
REDIS_PORT=6379

# --- Infrastructure & Cache Sizing ---
REDIS_MAXMEMORY=512mb

# --- Local Host Connection URLs (For running tests or tooling outside Docker) ---
# Note: Inside Docker Compose, containers automatically route via internal DNS:
#   - Database: mysql:3306
#   - Broker/Cache: redis:6379
#   - MLflow: mlflow:5000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=mysql+pymysql://aml_user:aml_secure_password@localhost:3307/aml_db
API_URL=http://localhost:8000/api/v1
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Core ML & Business Rule Constants ---
START_STEP=743
FRAUD_THRESHOLD=0.5
