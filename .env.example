# ==========================================
# Enterprise AML Microservice Environment Variables
# Copy this file to .env and adjust as needed.
# ==========================================

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=aml_db
MYSQL_USER=aml_user
MYSQL_PASSWORD=aml_secure_password

# --- Infrastructure Service URLs (for local development outside Docker) ---
# When running locally on host:
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=mysql+pymysql://aml_user:aml_secure_password@localhost:3307/aml_db
API_URL=http://localhost:8000/api/v1
MLFLOW_TRACKING_URI=http://localhost:5000

# Note: Inside Docker Compose, services use internal hostnames automatically:
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# --- Application Constants ---
START_STEP=743
FRAUD_THRESHOLD=0.5
